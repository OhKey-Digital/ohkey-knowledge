---
import BaseLayout from '../layouts/BaseLayout.astro';

let activeQuiz: { id: string; title: string; description?: string } | null = null;

try {
  const url = new URL('/api/quiz/active', Astro.url.origin);
  const res = await fetch(url.toString());
  if (res.ok) {
    const data = await res.json();
    activeQuiz = data.quiz ?? null;
  }
} catch {
  // No hay quiz activo o el fetch falló; se muestra la pantalla de espera
}
---

<BaseLayout title="Inicio">
  <div class="container">
    {activeQuiz ? (
      <section class="hero">
        <div class="hero-badge">Quiz disponible</div>
        <h1 class="hero-title">
          {activeQuiz.title}
        </h1>
        {activeQuiz.description && (
          <p class="hero-subtitle">{activeQuiz.description}</p>
        )}
        <a href="/quiz" class="cta-btn">Comenzar quiz →</a>
      </section>
    ) : (
      <section class="hero hero--empty">
        <div class="hero-badge">Sin quiz activo</div>
        <h1 class="hero-title">
          Próximamente<br />
          <span class="hero-highlight">un nuevo quiz</span>
        </h1>
        <p class="hero-subtitle">
          No hay un quiz disponible en este momento.<br />
          Vuelve pronto o contacta al administrador.
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding-block: var(--space-12) var(--space-16);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 1rem;
    background: rgba(66, 51, 206, 0.2);
    border: 1px solid rgba(169, 178, 255, 0.3);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent-light);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 600px;
  }

  .hero-highlight {
    background: linear-gradient(135deg, var(--color-accent-light), var(--color-accent-vibrant));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    max-width: 480px;
    line-height: 1.7;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 2rem;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast);
    margin-top: var(--space-2);
  }

  .cta-btn:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .hero--empty .hero-badge {
    background: rgba(148, 163, 184, 0.15);
    border-color: rgba(148, 163, 184, 0.2);
    color: var(--color-text-muted);
  }
</style>
