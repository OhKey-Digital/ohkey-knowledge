---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PublicQuizApp } from '../components/quiz/PublicQuizApp';

let quiz: { id: string; title: string; description?: string; questions: unknown[] } | null = null;

try {
  const url = new URL('/api/quiz/active', Astro.url.origin);
  const res = await fetch(url.toString());
  if (res.ok) {
    const data = await res.json();
    quiz = data.quiz ?? null;
  }
} catch {
  // sin quiz
}

if (!quiz) {
  return Astro.redirect('/');
}
---

<BaseLayout
  title={quiz.title}
  description={quiz.description ?? 'Responde las preguntas y descubre tu nivel.'}
>
  <div class="container">
    <PublicQuizApp quiz={quiz as any} client:load />
  </div>
</BaseLayout>

<style>
  .container { padding-block: 0; }
</style>
